# ── Core ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# Public base URL of the deployment (used for QR codes / share links).
# Leave empty to derive it from incoming requests (not recommended in prod).
APP_URL=

# Port the HTTP server listens on (hosting providers usually inject this)
PORT=3000

# Number of proxy hops in front of the app (1 for most hosts, 0 for none)
TRUST_PROXY=0

# ── Database — use ONE of the two options below ─────────────────────────
#
# OPTION 1 (recommended on Wasmer Edge): attach a managed database via
# `capabilities.database` in app.yaml. Wasmer injects the DB_* variables
# automatically at runtime and config/index.js reads them — nothing to do.
#
#   DB_HOST=          <- injected by Wasmer, don't set these by hand
#   DB_PORT=
#   DB_NAME=
#   DB_USERNAME=
#   DB_PASSWORD=
#
# OPTION 2: a remote managed PostgreSQL connection string
# (Neon, Supabase, Railway, ...). NEVER localhost in production.
DATABASE_URL=postgresql://user:password@your-managed-postgres-host:5432/restaurants

# ── Security secrets (CHANGE IN PRODUCTION — use long random values) ───
# openssl rand -base64 48
SESSION_SECRET=change-me-generate-a-long-random-string
SESSION_TTL_HOURS=12

# ── Rate limiting (per IP) ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10
ORDER_RATE_WINDOW_MS=3600000
ORDER_RATE_MAX=20

# ── Uploads ─────────────────────────────────────────────────────────────
# NOTE: on ephemeral hosts (e.g. Wasmer Edge) this directory does not
# survive redeploys; plug remote object storage into server/middleware/upload.js.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=2

# ── Browser Web Push (owner new-order alerts) ─────────────────────────
# Single platform-wide VAPID keypair. Generate once locally and keep the
# private key secret (never commit it):
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Push stays OFF unless PUSH_ENABLED=1 AND VAPID_PUBLIC_KEY is set.
# VAPID_SUBJECT is the contact identity push services use (your email).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_ENABLED=0

# ── Bootstrap super admin (used only by `npm run seed:admin`) ───────────
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Optional: bootstrap seed restaurants (`npm run seed:demo`) ──────────
SEED_DEMO_PASSWORD=
